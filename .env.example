# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: Required for database and authentication via @supabase/ssr.
# Copy these values from your Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Optional: Server-only service role key (alternative to SQL RPCs for public /r/[requestId] route)
SUPABASE_SERVICE_ROLE_KEY=""

# CRON & MESSAGING (Step 4 - Optional)
# Secret bearer token to authorize automated Vercel Cron calls to /api/cron/enviar-pendientes (and /api/cron/send-reminders)
CRON_SECRET=""

# Optional Meta WhatsApp Cloud API credentials.
# In production, missing credentials return an error unless ALLOW_SIMULATED_WHATSAPP="true".
WHATSAPP_PHONE_NUMBER_ID="tu_phone_number_id"
WHATSAPP_ACCESS_TOKEN=""
# Approved Meta template name & language code for business-initiated messages outside the 24h window.
# Expected body variables in order: {{1}} customer_name, {{2}} business_name, {{3}} review_link
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="es"
# ALLOW_SIMULATED_WHATSAPP="false"

# MONETIZATION (Step 5 - Optional)
# Direct Stripe Payment Link URL. If omitted, dashboard uses simulated Pro activation.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=""
